      { name: "Релокация и туры", icon: Plane, children:[{name:"Сервис переезда"},{name:"Запись на тур"}] },
      { name: "Ипотека и льготы", icon: Percent, children:[{name:"Калькулятор"},{name:"Банки‑партнёры"}] },
      { name: "Доверительное управление", icon: HeartHandshake, children:[{name:"Аренда"},{name:"Отчёты"}] },
      { name: "Кейсы и отзывы", icon: MessageSquareText },
      { name: "Блог", icon: Newspaper },
      { name: "О компании", icon: ShieldCheck, children:[{name:"Команда"},{name:"Ценности"},{name:"Партнёры"}] },
      { name: "Контакты", icon: Phone }
    ]}
  ];

  const Node = ({ node, depth=0 }: any) => {
    const [open, setOpen] = React.useState(true);
    const Icon = (node.icon || Home);
    const hasChildren = Array.isArray(node.children) && node.children.length>0;
    return (
      <div className={`rounded-xl ${depth===0?"bg-muted p-4":""}`}>
        <button onClick={()=>setOpen(!open)} className="flex w-full items-center gap-2 py-2">
          {hasChildren && <ChevronDown className={`size-4 transition-transform ${open?"rotate-0":"-rotate-90"}`} />}
          <Icon className="size-4"/>
          <span className="font-medium">{node.name}</span>
        </button>
        {hasChildren && open && (
          <div className="pl-6 border-l mt-1 space-y-1">
            {node.children.map((ch:any, i:number)=> <Node key={i} node={ch} depth={depth+1}/>) }
          </div>
        )}
      </div>
    );
  };

  return (
    <Section id="sitemap" title="Карта разделов (sitemap)" hint="Наглядная структура сайта и ключевых страниц.">
      <div className="grid md:grid-cols-2 gap-6">
        <Card>
          <CardHeader>
            <CardTitle>Дерево навигации</CardTitle>
            <CardDescription>Разделы первого и второго уровня.</CardDescription>
          </CardHeader>
          <CardContent>
            {tree.map((n,i)=> <Node key={i} node={n} />)}
          </CardContent>
        </Card>
        <MortgageMiniCalc />
      </div>
    </Section>
  );
}

