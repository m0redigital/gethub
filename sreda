function MortgageMiniCalc() {
  const [price, setPrice] = React.useState(12000000);
  const [down, setDown] = React.useState(2400000);
  const [rate, setRate] = React.useState(6);
  const [years, setYears] = React.useState(20);

  const principal = Math.max(price - down, 0);
  const n = years * 12;
  const i = rate / 100 / 12;
  const payment = i === 0 ? principal / n : principal * (i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2"><Calculator className="size-5"/> Калькулятор семейной ипотеки</CardTitle>
        <CardDescription>Черновая оценка ежемесячного платежа. Точный расчёт — на консультации.</CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        <div className="grid md:grid-cols-2 gap-4">
          <div>
            <label className="text-sm text-muted-foreground">Стоимость, ₽</label>
            <Input type="number" value={price} onChange={(e:any)=>setPrice(Number(e.target.value))} />
          </div>
          <div>
            <label className="text-sm text-muted-foreground">Первоначальный взнос, ₽</label>
            <Input type="number" value={down} onChange={(e:any)=>setDown(Number(e.target.value))} />
          </div>
          <div>
            <label className="text-sm text-muted-foreground">Ставка, %</label>
            <Input type="number" step="0.1" value={rate} onChange={(e:any)=>setRate(Number(e.target.value))} />
          </div>
          <div>
            <label className="text-sm text-muted-foreground">Срок, лет</label>
            <Input type="number" value={years} onChange={(e:any)=>setYears(Number(e.target.value))} />
          </div>
        </div>
        <div className="rounded-xl bg-muted p-4">
          <div className="text-sm text-muted-foreground">Ежемесячный платёж, ₽</div>
          <div className="text-2xl md:text-3xl font-semibold">{Math.round(payment).toLocaleString("ru-RU")}</div>
        </div>
        <Dialog>
          <DialogTrigger asChild>
            <Button className="w-full md:w-auto">Получить точный расчёт</Button>
          </DialogTrigger>
          <DialogContent className="sm:max-w-md">
            <DialogHeader>
              <DialogTitle>Заявка на расчёт</DialogTitle>
            </DialogHeader>
            <div className="space-y-3">
              <Input placeholder="Имя" />
              <Input placeholder="Телефон" />
              <Textarea placeholder="Опишите ситуацию: дети, доход, регион" />
              <Button>Отправить</Button>
            </div>
          </DialogContent>
        </Dialog>
      </CardContent>
    </Card>
  );
}

